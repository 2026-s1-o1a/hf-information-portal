@using Umbraco.Cms.Web.Common

@inherits UmbracoViewPage

@{
    Layout = null;

    var formIdValue = Context.Request.Query["formId"].FirstOrDefault();

    Guid formId;
    var validFormId = Guid.TryParse(formIdValue, out formId);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Survey</title>
</head>

<body>
    @if (!validFormId)
    {
        <p>Invalid or missing form ID.</p>
    }
    else
    {
        @await Component.InvokeAsync(
            "RenderForm",
            new
            {
                formId = formId,
                theme = "default",
                includeScripts = true
            }
        )
    }

</body>
</html>

